# =====================================================
# Copy file nay thanh .env roi dien gia tri that.
# KHONG commit file .env (da nam trong .gitignore).
# =====================================================

# ===== Database (MySQL) =====
# DB_NAME phai trung ten trong backend/scripts/create_database.sql
DB_NAME=family_finance_db
# Docker: KHONG dung root (image MySQL tu choi MYSQL_USER=root).
# Chay backend ngoai Docker bang MySQL tren may: dat DB_USER=root trong .env ca nhan.
DB_USER=finance_user
DB_PASSWORD=your_db_password
DB_ROOT_PASSWORD=your_root_password

# ===== Cloudinary =====
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ===== Backend (Spring Boot) =====
BACKEND_PORT=8080
# Tao bang: openssl rand -hex 32
JWT_SECRET_KEY=your_jwt_secret_hex_64chars
JWT_EXPIRATION_MS=86400000
REFRESH_EXPIRATION_DAYS=7

# ===== Admin =====
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@familyfinance.local
ADMIN_PASSWORD=your_admin_password

# ===== AI (OpenAI) =====
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# ===== Frontend =====
FRONTEND_PORT=3000
# Docker khong dung bien nay (compose da dat rong, frontend goi API qua Nginx proxy).
VITE_API_BASE_URL=http://localhost:8080

# ===== Chung =====
TZ=Asia/Ho_Chi_Minh